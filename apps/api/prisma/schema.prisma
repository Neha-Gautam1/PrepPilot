generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  passwordHash          String
  createdAt             DateTime                @default(now())
  sessions              Session[]
  activities            Activity[]
  mockInterviewSessions MockInterviewSession[]
  skillProfiles         SkillProfile[]
  resumeReviews ResumeReview[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Topic {
  id                    String                  @id @default(uuid())
  name                  String
  slug                  String                  @unique
  description           String?
  parentId              String?
  parent                Topic?                  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children              Topic[]                 @relation("TopicHierarchy")
  questions             Question[]
  sqlExercises          SqlExercise[]
  activities            Activity[]
  dsaProblems           DsaProblem[]
  mockInterviewSessions MockInterviewSession[]
  skillProfiles         SkillProfile[]
  createdAt             DateTime                @default(now())

  @@index([parentId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id              String     @id @default(uuid())
  topicId         String
  topic           Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  prompt          String
  options         Json
  correctOptionId String
  explanation     String?
  difficulty      Difficulty @default(MEDIUM)
  attempts        Attempt[]
  createdAt       DateTime   @default(now())

  @@index([topicId])
}

model SqlExercise {
  id                 String     @id @default(uuid())
  topicId            String
  topic              Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  prompt             String
  canonicalQuery     String
  expectedResultJson Json
  difficulty         Difficulty @default(MEDIUM)
  createdAt          DateTime   @default(now())
  attempts           Attempt[]

  @@index([topicId])
}

enum ActivityType {
  MCQ
  SQL
  DSA
}

model Activity {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      ActivityType
  createdAt DateTime     @default(now())
  attempt   Attempt?

  @@index([userId])
  @@index([topicId])
  @@index([userId, createdAt])
}

model Attempt {
  id               String       @id @default(uuid())
  activityId       String       @unique
  activity         Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  questionId       String?
  question         Question?    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?

  sqlExerciseId    String?
  sqlExercise      SqlExercise? @relation(fields: [sqlExerciseId], references: [id], onDelete: Cascade)
  submittedQuery   String?
  executionError   String?

  dsaProblemId     String?
  
  dsaProblem       DsaProblem?  @relation(fields: [dsaProblemId], references: [id], onDelete: Cascade)
  submittedCode    String?
  language         String?      @default("javascript")
  testsPassed      Int?
  testsTotal       Int?
  hintsUsed        Int?         @default(0)

  isCorrect        Boolean
  timeTakenMs      Int
  createdAt        DateTime     @default(now())

  @@index([questionId])
  @@index([sqlExerciseId])
  @@index([dsaProblemId])
}

model SkillProfile {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId                 String
  topic                   Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  masteryScore            Float
  totalWeightedAttempts   Float
  correctWeightedAttempts Float
  lastPracticedAt         DateTime?
  computedAt              DateTime  @default(now())

  @@unique([userId, topicId])
  @@index([userId])
}

model DsaProblem {
  id           String     @id @default(uuid())
  topicId      String
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  prompt       String
  functionName String
  starterCode  String
  testCases    Json
  difficulty   Difficulty @default(MEDIUM)
  createdAt    DateTime   @default(now())
  attempts     Attempt[]

  @@index([topicId])
}

enum InterviewType {
  TECHNICAL
  HR
}
model MockInterviewSession {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              InterviewType @default(TECHNICAL)
  topicId           String?
  topic             Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  transcript        Json
  technicalAccuracy Int
  communication     Int
  completeness      Int
  overallFeedback   String
  createdAt         DateTime      @default(now())

  @@index([userId])
}

model ResumeReview {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeText     String
  jobDescription String?
  feedback       String
  createdAt      DateTime @default(now())

  @@index([userId])
}