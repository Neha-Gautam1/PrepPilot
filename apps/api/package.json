{
  "name": "@preppilot/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/server.js",
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:sandbox": "node -r ts-node/register prisma/sandboxSeed.ts",
    "seed:dsa": "node -r ts-node/register prisma/dsaSeed.ts",
    "seed:more-topics": "node -r ts-node/register prisma/moreTopicsSeed.ts",
    "seed:more-topics-2": "node -r ts-node/register prisma/moreTopics2Seed.ts",
    "seed:more-topics-3": "node -r ts-node/register prisma/moreTopics3Seed.ts",
    "seed:more-topics-4": "node -r ts-node/register prisma/moreTopics4Seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
  }
}
